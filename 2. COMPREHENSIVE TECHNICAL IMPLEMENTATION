        }
    }
    
    async fn select_optimal_behavior(&self, candidates: &[EmergentCandidate]) -> EmergentBehaviorType {
        // Multi-criteria decision analysis
        let mut scored = Vec::new();
        
        for candidate in candidates {
            let score = self.score_candidate(candidate).await;
            scored.push((candidate, score));
        }
        
        // Sort by score
        scored.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap());
        
        // Select top candidate with some randomness for exploration
        if rand::random::<f64>() < EXPLORATION_PROBABILITY {
            // Exploration: choose random candidate from top 3
            let top_n = scored.iter().take(3).collect::<Vec<_>>();
            top_n.choose(&mut rand::thread_rng()).unwrap().0.behavior_type
        } else {
            // Exploitation: choose best candidate
            scored[0].0.behavior_type
        }
    }
}

