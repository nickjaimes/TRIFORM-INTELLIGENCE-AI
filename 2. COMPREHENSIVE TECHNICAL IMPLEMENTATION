impl CrossLayerBus {
    pub fn new() -> Self {
        let (stallion_tx, stallion_rx) = mpsc::unbounded_channel();
        let (crow_tx, crow_rx) = mpsc::unbounded_channel();
        let (ant_tx, ant_rx) = mpsc::unbounded_channel();
        let (meta_tx, meta_rx) = mpsc::unbounded_channel();
        
        Self {
            stallion_tx,
            stallion_rx,
            crow_tx,
            crow_rx,
            ant_tx,
            ant_rx,
            meta_tx,
            meta_rx,
            router: MessageRouter::new(),
            transformers: Self::initialize_transformers(),
            qos: QualityOfServiceManager::new(),
        }
    }
    
    pub async fn send(&self, message: LayerMessage, priority: Priority) -> Result<(), BusError> {
        // Apply QoS
        let prioritized = self.qos.apply(message, priority).await;
        
        // Transform if needed
        let transformed = self.transform(prioritized).await;
        
        // Route to appropriate channel(s)
        let destinations = self.router.route(&transformed).await;
        
        for destination in destinations {
            match destination {
                Destination::Stallion => {
                    self.stallion_tx.send(transformed.clone())?;
                }
                Destination::Crow => {
                    self.crow_tx.send(transformed.clone())?;
                }
                Destination::Ant => {
                    self.ant_tx.send(transformed.clone())?;
                }
                Destination::Meta => {
                    self.meta_tx.send(transformed.clone())?;
                }
                Destination::All => {
                    self.broadcast(transformed.clone()).await?;
                }
            }
        }
        
        Ok(())
    }
    
    pub async fn receive(&mut self, layer: SystemLayer) -> Option<LayerMessage> {
        match layer {
            SystemLayer::Stallion => self.stallion_rx.recv().await,
            SystemLayer::Crow => self.crow_rx.recv().await,
            SystemLayer::Ant => self.ant_rx.recv().await,
            SystemLayer::Meta => self.meta_rx.recv().await,
        }
    }
    
    async fn broadcast(&self, message: LayerMessage) -> Result<(), BusError> {
        self.stallion_tx.send(message.clone())?;
        self.crow_tx.send(message.clone())?;
        self.ant_tx.send(message.clone())?;
        self.meta_tx.send(message)?;
        
        Ok(())
    }
