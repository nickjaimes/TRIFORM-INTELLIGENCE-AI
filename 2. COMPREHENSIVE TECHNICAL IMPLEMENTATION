    pub async fn check_constraints(&self, action: &ProposedAction) -> ConstraintCheck {
        let mut violations = Vec::new();
        let mut warnings = Vec::new();
        
        for constraint in &self.constraints {
            match constraint.check(action).await {
                ConstraintResult::Satisfied => continue,
                ConstraintResult::Violated(reason) => {
                    violations.push((constraint.id.clone(), reason));
                }
                ConstraintResult::Warning(reason) => {
                    warnings.push((constraint.id.clone(), reason));
                }
            }
        }
        
        // Check for ethical dilemmas
        let dilemmas = self.detect_dilemmas(&violations, &warnings);
        
        // Resolve if dilemmas exist
        let resolution = if !dilemmas.is_empty() {
            self.dilemma_resolver.resolve(dilemmas).await
        } else {
            DilemmaResolution::NoDilemma
        };
        
        ConstraintCheck {
            allowed: violations.is_empty(),
            violations,
            warnings,
            dilemma_resolution: resolution,
            override_possible: self.check_override_possible(&violations),
        }
    }
}
