        // Check against core values
        let core_check = self.value_system.check(action).await;
        
        // Check for value drift
        let drift_check = self.value_preservation.check_for_drift(action).await;
        
        // Check extrapolated values
        let extrapolated_check = self.value_extrapolation.check(action).await;
        
        // Integrate checks
        let integrated = self.integrate_checks(core_check, drift_check, extrapolated_check).await;
        
        AlignmentCheck {
            passed: integrated.passed,
            reasons: integrated.reasons,
            alignment_score: integrated.score,
            required_adjustments: integrated.adjustments,
            human_verification_needed: integrated.needs_human_verification,
        }
    }
    
    pub async fn learn_from_human(&mut self, feedback: HumanFeedback) {
        // Update value system based on feedback
        self.value_learner.learn(feedback).await;
        
        // Ensure value stability
        self.value_preservation.ensure_stability().await;
        
        // Update extrapolated values
        self.value_extrapolation.update().await;
    }
